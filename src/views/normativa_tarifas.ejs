          <!-- 6. DESCARGA DE DOCUMENTOS OFICIALES Y ATENCIÓN -->
          <section class="max-w-7xl mx-auto px-6 lg:px-12 py-10 w-full">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
