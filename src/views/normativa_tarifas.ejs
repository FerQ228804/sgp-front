                  </h3>
                  <p class="font-body-md text-xs text-on-primary/90 leading-relaxed">
                    Nuestro canal de Atención y Soporte está disponible para
                    resolver discrepancias en minutos de permanencia o validar
                    pases especiales.
                  </p>
                </div>
                <div class="pt-6">
                  <a class="inline-flex items-center justify-center w-full h-11 px-5 rounded-lg bg-surface-container-lowest text-primary hover:bg-white font-button-text text-button-text transition-colors shadow-sm gap-2"
                    data-path="atencion-y-soporte"
                    href="/support">
                    <span class="material-symbols-outlined text-[18px]">headset_mic</span>
                    <span class="">Contactar a Atención y Soporte</span>
                  </a>
                </div>
              </div>
            </div>
          </section>
        </div>
        <!-- Interactive Logic for the Simulator -->
        <script>
          (function () {
            // Configuration parameters
            const rates = {
              car: {
                name: "Automóvil / Camioneta",
                freeHours: 2,
                hourlyRate: 3500,
                dailyCap: 35000,
                note: "Tarifa base para bahías de visitantes diurnas.",
              },
              moto: {
                name: "Motocicleta",
                freeHours: 2,
                hourlyRate: 2000,
                dailyCap: 20000,
                note: "Bahía demarcada con anclajes en Garita 1.",
              },
              pmr: {
                name: "Movilidad Reducida (PMR)",
                freeHours: 3,
                hourlyRate: 3000,
                dailyCap: 30000,
                note: "Incluye 3 horas de cortesía con distintivo visible.",
              },
            };

            let currentVehicle = "car";
            let currentHours = 3;

            // DOM Elements
            const vehicleButtons = document.querySelectorAll(".vehicle-btn");
            const hoursSlider = document.getElementById("hours-slider");
            const hoursDisplayText =
              document.getElementById("hours-display-text");
            const btnReset = document.getElementById("btn-reset-calc");

            const summaryVehicle = document.getElementById("summary-vehicle");
            const summaryTotalHours = document.getElementById(
              "summary-total-hours",
            );
            const summaryDiscountHours = document.getElementById(
              "summary-discount-hours",
            );
            const summaryBilledHours = document.getElementById(
              "summary-billed-hours",
            );
            const summaryRate = document.getElementById("summary-rate");
            const summaryTotalAmount = document.getElementById(
              "summary-total-amount",
            );
            const summaryNote = document.getElementById("summary-note");

            function formatCOP(number) {
              return (
                "$" + number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".")
              );
            }

            function updateCalculation() {
              const config = rates[currentVehicle];
              const free = config.freeHours;
              const totalH = parseInt(currentHours, 10);

              let billedH = Math.max(0, totalH - free);
              let totalVal = billedH * config.hourlyRate;

              // Cap at daily rate if exceeded
              if (totalVal > config.dailyCap) {
                totalVal = config.dailyCap;
              }

              // Update UI
              if (hoursDisplayText) {
                hoursDisplayText.textContent =
                  totalH + (totalH === 1 ? " hora" : " horas");
              }
              if (summaryVehicle) {
                summaryVehicle.textContent = config.name;
              }
              if (summaryTotalHours) {
                summaryTotalHours.textContent =
                  totalH + (totalH === 1 ? " hora" : " horas");
              }
              if (summaryDiscountHours) {
                summaryDiscountHours.textContent = `- ${free} horas ($0 COP)`;
              }
              if (summaryBilledHours) {
                summaryBilledHours.textContent =
                  billedH + (billedH === 1 ? " hora" : " horas");
              }
              if (summaryRate) {
                summaryRate.textContent = formatCOP(config.hourlyRate) + " COP";
              }
              if (summaryTotalAmount) {
                summaryTotalAmount.textContent = formatCOP(totalVal);
              }
              if (summaryNote) {
                summaryNote.textContent =
                  totalVal >= config.dailyCap
                    ? "Se aplicó el tope diario de sobreestadía ($" +
                      formatCOP(config.dailyCap) +
                      ")."
                    : config.note;
              }
            }

            function updateVehicleButtons() {
              vehicleButtons.forEach((btn) => {
                const type = btn.getAttribute("data-vehicle");
                if (type === currentVehicle) {
                  btn.classList.remove(
                    "bg-surface-container-low",
                    "text-on-surface-variant",
                  );
                  btn.classList.add("bg-surface-container", "text-primary");
                } else {
                  btn.classList.remove("bg-surface-container", "text-primary");
                  btn.classList.add(
                    "bg-surface-container-low",
                    "text-on-surface-variant",
                  );
                }
              });
            }

            // Event listeners
            vehicleButtons.forEach((btn) => {
              btn.addEventListener("click", () => {
                currentVehicle = btn.getAttribute("data-vehicle");
                updateVehicleButtons();
                updateCalculation();
              });
            });

            if (hoursSlider) {
              hoursSlider.addEventListener("input", (e) => {
                currentHours = e.target.value;
                updateCalculation();
              });
            }

            if (btnReset) {
              btnReset.addEventListener("click", () => {
                currentVehicle = "car";
                currentHours = 3;
                if (hoursSlider) hoursSlider.value = 3;
                updateVehicleButtons();
                updateCalculation();
              });
            }

            // Init
            updateCalculation();
          })();
        </script>
      </div>
    </main>
    <%- include("Partials/footer") %>
    
  </body>
</html>
