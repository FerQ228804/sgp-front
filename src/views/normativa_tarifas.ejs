                      <div class="w-10 h-10 rounded-lg bg-surface-container-lowest flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors shrink-0 shadow-sm">
                        <span class="material-symbols-outlined text-[22px]"
                          >picture_as_pdf</span>
                      </div>
                      <div class="flex flex-col min-w-0">
                        <span class="font-label-bold text-xs text-on-surface group-hover:text-primary transition-colors truncate"
