                          <div
                            class="font-link text-link text-on-surface-variant text-xs"
                          >
                            Lectura QR y comprobación de placa
                          </div>
                        </div>
                      </div>
                      <span
                        class="font-label-bold text-label-bold text-primary text-sm"
