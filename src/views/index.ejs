                    140 Cupos
                  </div>
                  <div class="font-subtitle text-subtitle text-white/80">
                    Capacidad total censada
                  </div>
                </div>
              </div>
              <div
                class="flex items-center justify-center md:justify-start gap-4"
              >
                <div
