            "surface-container-highest": "#e0e3e5",
          },
          fontFamily: {
            sans: ["Inter", "sans-serif"],
          },
        },
      },
    };
  </script>    
  <style>
    .bg-dot-pattern {
      background-image: radial-gradient(
        rgba(15, 23, 42, 0.08) 1.2px,
