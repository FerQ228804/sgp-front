      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-800 via-blue-700 to-blue-600 flex items-center justify-center text-white font-bold text-xl shadow-md shadow-blue-700/20 group-hover:scale-105 transition-transform duration-200">
        P
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-slate-900 tracking-tight text-base leading-tight">SGP Geranio</span>
        <span class="text-[11px] font-medium text-slate-500 tracking-wide uppercase">Conjunto Residencial</span>
      </div>
    </a>
