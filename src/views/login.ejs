<!DOCTYPE html>
<html class="h-full bg-slate-50" lang="es"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Inicio de Sesión | SGP Geranio</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#003f87",
            "primary-container": "#0056b3",
            "on-primary": "#ffffff",
            surface: "#f8fafc",
            "on-surface": "#0f172a",
            "on-surface-variant": "#475569",
            outline: "#94a3b8",
            "outline-variant": "#cbd5e1"
          },
          fontFamily: {
            sans: ["Inter", "sans-serif"]
          }
        }
      }
    }
  </script>
<style>
    .bg-dot-pattern {
      background-image: radial-gradient(rgba(15, 23, 42, 0.08) 1.2px, transparent 1.2px);
      background-size: 24px 24px;
    }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
    }
  </style>
  </head>
  <body class="min-h-full font-sans text-slate-900 bg-[#f8fafc] flex flex-col justify-between relative selection:bg-blue-600 selection:text-white antialiased">
    <!-- Background radial subtle glow & dot pattern -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute inset-0 bg-dot-pattern opacity-70"></div>
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[500px] bg-gradient-to-b from-blue-100/60 via-blue-50/30 to-transparent blur-3xl rounded-full"></div>
      <div class="absolute bottom-0 right-10 w-96 h-96 bg-blue-50/40 blur-3xl rounded-full"></div>
    </div>
    <!-- 1. Top Navbar -->
    <header class="relative z-20 w-full bg-white/90 backdrop-blur-md border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Brand Logo identical to Landing Page & Suite Geranio -->
        <a class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-blue-600 rounded-lg pr-2 py-1" href="/">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-800 via-blue-700 to-blue-600 flex items-center justify-center text-white font-bold text-xl shadow-md shadow-blue-700/20 group-hover:scale-105 transition-transform duration-200">
            P
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-slate-900 tracking-tight text-base leading-tight">SGP Geranio</span>
            <span class="text-[11px] font-medium text-slate-500 tracking-wide uppercase">Conjunto Residencial</span>
          </div>
        </a>
        <!-- Right Nav Action -->
        <div class="flex items-center gap-3 sm:gap-4">
          <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200/60 rounded-full text-xs font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Conexión Segura TLS 256-bit
          </div>
          <a class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 bg-white hover:bg-slate-100/80 border border-slate-300/80 shadow-sm hover:shadow transition-all duration-150 active:scale-95" href="/">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            <span>Volver al inicio</span>
          </a>
        </div>
      </div>
    </header>
    <!-- Main Login Workspace -->
    <main class="relative z-10 flex-1 flex flex-col items-center justify-center px-4 py-10 sm:py-14">
      <div class="w-full max-w-[460px]">
        <!-- Card Container -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xl shadow-slate-200/50 p-7 sm:p-9 relative backdrop-blur-sm">
          <!-- Header / Badge -->
          <div class="flex flex-col items-center text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-50 border border-blue-100 rounded-full text-xs font-medium text-blue-700 mb-4">
              <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                Portal Oficial de Acceso
            </div>
            <div class="w-12 h-12 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-center justify-center text-blue-700 mb-3 shadow-sm">
              <span class="material-symbols-outlined text-2xl">local_police</span>
            </div>
            <h1 class="text-2xl sm:text-[26px] font-bold tracking-tight text-slate-900 leading-tight">
              Inicio de Sesión
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1.5 leading-relaxed max-w-sm">
              Sistema de Control de Ingreso y Gestión de Parqueaderos
            </p>
          </div>
          <!-- Pestañas de selección de modo/rol -->
          <div class="mt-6 p-1 bg-slate-100/90 rounded-xl grid grid-cols-2 gap-1 border border-slate-200/60" role="tablist">
            <button class="py-2 px-2.5 text-xs font-semibold rounded-lg bg-white text-blue-800 shadow-sm border border-slate-200/50 flex items-center justify-center gap-1.5 transition-all" id="btn-role-guardia" onclick="selectRole('guardia')" type="button">
              <span class="material-symbols-outlined text-[16px] text-blue-600">shield_person</span>
              <span>Garita / Guardia</span>
            </button>
            <button class="py-2 px-2.5 text-xs font-medium text-slate-600 hover:text-slate-900 rounded-lg hover:bg-white/60 flex items-center justify-center gap-1.5 transition-all" id="btn-role-admin" onclick="selectRole('admin')" type="button">
              <span class="material-symbols-outlined text-[16px] text-slate-500">admin_panel_settings</span>
              <span>Administración</span>
            </button>
          </div>
          <!-- Formulario -->
          <form class="mt-6 space-y-4" onsubmit="event.preventDefault();">
            <!-- Campo de nombre de usuario o Email -->
            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-slate-700 tracking-wide" for="username">
                Usuario o correo corporativo
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                  <span class="material-symbols-outlined text-[19px]">account_circle</span>
                </div>
                <input autocomplete="username" class="w-full pl-10 pr-4 py-2.5 text-sm bg-slate-50/50 focus:bg-white border border-slate-300 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-700 transition-all shadow-sm" id="username" name="username" placeholder="ej: guardia.garita1@geranioph.com" required="" type="text"/>
              </div>
            </div>
            <!-- Campo de contraseña -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <label class="block text-xs font-semibold text-slate-700 tracking-wide" for="password">
                  Contraseña
                </label>
              </div>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                  <span class="material-symbols-outlined text-[19px]">lock</span>
                </div>
                <input autocomplete="current-password" class="w-full pl-10 pr-11 py-2.5 text-sm bg-slate-50/50 focus:bg-white border border-slate-300 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-700 transition-all shadow-sm" id="password" name="password" placeholder="••••••••••••" required="" type="password"/>
                <button aria-label="Mostrar u ocultar contraseña" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none" onclick="const p = document.getElementById('password'); const icon = this.querySelector('span'); if (p.type === 'password') { p.type = 'text'; icon.textContent = 'visibility_off'; } else { p.type = 'password'; icon.textContent = 'visibility'; }" tabindex="-1" type="button">
                  <span class="material-symbols-outlined text-[19px]">visibility</span>
                </button>
              </div>
            </div>
            <!-- Utilidad para recordar y recuperar contraseñas -->
            <div class="flex items-center justify-between pt-1">
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input class="w-4 h-4 rounded border-slate-300 text-blue-700 focus:ring-blue-600/30 transition" type="checkbox"/>
                <span class="text-xs font-medium text-slate-600">Recordar credenciales</span>
              </label>
              <a class="text-xs font-semibold text-blue-700 hover:text-blue-800 hover:underline" href="#">
                ¿Olvidó su contraseña?
              </a>
            </div>
            <!-- Submit CTA Button -->
            <div class="pt-2">
              <button class="w-full py-3 px-4 bg-gradient-to-r from-blue-700 to-blue-800 hover:from-blue-800 hover:to-blue-900 text-white font-semibold text-sm rounded-xl shadow-md shadow-blue-700/25 hover:shadow-lg hover:shadow-blue-700/35 active:scale-[0.99] flex items-center justify-center gap-2 transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2" type="submit">
                <span>Ingresar al Sistema</span>
                <span class="material-symbols-outlined text-lg">arrow_forward</span>
              </button>
            </div>
          </form>
          <!-- Access Notice / Quick Disclaimer -->
          <div class="mt-6 pt-5 border-t border-slate-100 flex items-start gap-2.5 text-slate-500 bg-slate-50/70 p-3 rounded-xl border border-slate-200/50">
            <span class="material-symbols-outlined text-slate-400 text-base shrink-0 mt-0.5">verified_user</span>
            <p class="text-[11px] leading-normal">
              Acceso restringido únicamente a personal operativo y administrativo autorizado del <strong class="text-slate-700 font-semibold">Conjunto Residencial Geranio P.H.</strong>
            </p>
          </div>
        </div>
        <!-- Under Card Support Info -->
        <div class="mt-6 text-center space-y-2">
          <p class="text-xs text-slate-600">
            ¿Problemas para acceder a su turno?
            <a class="font-semibold text-blue-700 hover:underline inline-flex items-center gap-0.5 ml-1" href="/support">
              Contactar a soporte técnico
              <span class="material-symbols-outlined text-[13px]">open_in_new</span>
            </a>
          </p>
        </div>
      </div>
    </main>
    <!-- 4. Footer -->
    <footer class="relative z-10 w-full border-t border-slate-200 bg-white/70 py-4 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
        <div class="flex items-center gap-2">
          <span>© 2026 SGP Geranio P.H.</span>
          <span>•</span>
          <span>Control de Garita &amp; Parqueaderos</span>
        </div>
        <div class="flex items-center gap-4 text-slate-500">
          <div class="inline-flex items-center gap-1.5 font-medium text-slate-600">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Servidor Central En Línea</span>
          </div>
          <span class="text-slate-300">|</span>
          <span>Garita 1 &amp; 2 Activas</span>
        </div>
      </div>
    </footer>
    <script>
      function selectRole(role) {
        const btnGuardia = document.getElementById('btn-role-guardia');
        const btnAdmin = document.getElementById('btn-role-admin');
        const usernameInput = document.getElementById('username');
        const iconGuardia = btnGuardia.querySelector('span');
        const iconAdmin = btnAdmin.querySelector('span');
        
        const activeClasses = ['bg-white', 'text-blue-800', 'shadow-sm', 'font-semibold', 'border', 'border-slate-200/50'];
        const inactiveClasses = ['text-slate-600', 'hover:text-slate-900', 'font-medium', 'hover:bg-white/60'];
        
        if (role === 'guardia') {
          btnGuardia.classList.remove(...inactiveClasses); 
          btnGuardia.classList.add(...activeClasses); 
          iconGuardia.className = 'material-symbols-outlined text-[16px] text-blue-600';
          
          btnAdmin.classList.remove(...activeClasses);
          btnAdmin.classList.add(...inactiveClasses);
          iconAdmin.className = 'material-symbols-outlined text-[16px] text-slate-500';
          
          usernameInput.placeholder = 'ej: guardia.garita1@geranioph.com';
        }
        else if (role === 'admin') {
          btnAdmin.classList.remove(...inactiveClasses); 
          btnAdmin.classList.add(...activeClasses); 
          iconAdmin.className = 'material-symbols-outlined text-[16px] text-blue-600';
          
          btnGuardia.classList.remove(...activeClasses);
          btnGuardia.classList.add(...inactiveClasses);
          iconGuardia.className = 'material-symbols-outlined text-[16px] text-slate-500';
          
          usernameInput.placeholder = 'ej: administrador@geranioph.com';
        }
      }
    </script>
  </body>
</html>
