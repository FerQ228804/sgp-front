<script>
  // Micro-interacción: Cambio dinámico de pestañas del selector de rango temporal
  document.querySelectorAll('.time-tab').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelectorAll('.time-tab').forEach(b => {
        b.classList.remove('bg-surface-container-lowest', 'text-primary', 'shadow-sm', 'font-label-bold');
        b.classList.add('text-on-surface-variant', 'font-subtitle');
      });
      button.classList.add('bg-surface-container-lowest', 'text-primary', 'shadow-sm', 'font-label-bold');
      button.classList.remove('text-on-surface-variant', 'font-subtitle');
    });
  });
