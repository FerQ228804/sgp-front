<!-- Realtime Garita Clock Script -->
<script>
    function updateGaritaClock() {
      const el = document.getElementById('live-garita-clock');
      if (!el) return;
      const now = new Date();
      el.textContent = now.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });
    }
    setInterval(updateGaritaClock, 1000);
    updateGaritaClock();
  </script>
